# Dolby Digital Plus and AC-4 audio decoders (stock vendor.dolby.media.c2@1.0-service).
service vendor.media.c2-dolby-audio /vendor/bin/hw/android.hardware.media.c2-dolby-service /vendor/lib64/libcodec2_store_dolby.so default1
    class hal
    user mediacodec
    group camera mediadrm drmrpc
    ioprio rt 4
    task_profiles ProcessCapacityHigh

# Dolby Vision decoders (stock dolbycodec2).
service vendor.media.c2-dolby-vision /vendor/bin/hw/android.hardware.media.c2-dolby-service /vendor/lib64/c2.dolby.store.so default2
    class hal
    user mediacodec
    group camera mediadrm drmrpc
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
