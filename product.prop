# Audio
ro.audio.spatializer_enabled=true

# Camera
# Stock sets these for the Xiaomi camera app, which gates features on them.
# Kept on product: vendor build props may not set persist.sys.* properties.
persist.sys.miui.camera.quickcamera.supported=true
persist.sys.miui.camera.version=3.0
ro.product.camera.livephoto.support=3

# Marketname
ro.product.marketname=Redmi Note 14 Pro 5G
