cc_library {
    name: "libudfpshandler",
    defaults: ["xiaomi_hardware_biometrics_config_default"],
    vendor: true,
    srcs: ["UdfpsHandler.cpp"],
    shared_libs: [
        "libbase",
    ],
    static_libs: [
        "android.hardware.biometrics.fingerprint-V4-ndk",
    ],
    header_libs: [
        "//hardware/xiaomi:xiaomifingerprint_headers",
    ],
}

// mi_disp.h, the Xiaomi display feature interface, for the touch HAL too.
cc_library_headers {
    name: "malachite_mi_disp_headers",
    vendor: true,
    export_include_dirs: ["."],
}
