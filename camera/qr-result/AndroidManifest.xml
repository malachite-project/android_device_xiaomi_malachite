<!-- The Xiaomi camera decodes QR codes itself (bundled ML Kit) and sends the
     text to com.xiaomi.scanner's BarCodeScannerReceiver. It also turns QR
     scanning off unless a package with that name is installed. The names here
     match what the camera expects; the code is our own. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xiaomi.scanner">

    <!-- The camera holds this permission. Signature level: only apps signed
         like the camera (platform) can send us results. -->
    <permission
        android:name="com.xiaomi.scanner.receiver.RECEIVER"
        android:protectionLevel="signature" />

    <!-- Show the result dialog from the camera's broadcast. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <receiver
            android:name=".module.code.app.BarCodeScannerReceiver"
            android:exported="true"
            android:permission="com.xiaomi.scanner.receiver.RECEIVER">
            <intent-filter>
                <action android:name="com.xiaomi.scanner.receiver.senderbarcodescanner" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".module.code.app.QrResultActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/QrResultTheme" />
    </application>
</manifest>
