// Receives QR codes decoded by the Xiaomi camera, which hands them to
// com.xiaomi.scanner, and offers to open, copy or share them.
android_app {
    name: "MalachiteQrResult",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    product_specific: true,
    sdk_version: "current",
}
