// Stock picks a mi_thermald table per scene (video, games, camera, calls ...)
// through Xiaomi's PowerKeeper, which we do not ship. This app does the same
// with stock's scenario table (res/xml/thermal_setting.xml = odm setting.xml)
// and stock's built-in app groups.
android_app {
    name: "MalachiteThermalScene",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
}
