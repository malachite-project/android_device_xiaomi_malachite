<!-- Writes the thermal scene to mi_thermald like stock's PowerKeeper. Runs as
     system (system_app) so it can write sconfig, which init gives to system. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.malachite.thermal"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:name=".ThermalSceneApp"
        android:allowBackup="false"
        android:directBootAware="true"
        android:label="Thermal scenes"
        android:persistent="true" />
</manifest>
