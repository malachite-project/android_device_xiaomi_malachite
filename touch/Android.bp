cc_binary {
    name: "vendor.lineage.touch-service.malachite",
    init_rc: ["vendor.lineage.touch-service.malachite.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.malachite.xml"],
    relative_install_path: "hw",
    srcs: [
        "HighTouchPollingRate.cpp",
        "service.cpp",
    ],
    header_libs: [
        "malachite_mi_disp_headers",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.lineage.touch-V1-ndk",
    ],
    vendor: true,
}
