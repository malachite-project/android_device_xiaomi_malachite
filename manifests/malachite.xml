<?xml version="1.0" encoding="UTF-8"?>
<!--
     Local manifest for building LineageOS 23.2 for malachite entirely from
     the noamtu123 forks. Copy to .repo/local_manifests/malachite.xml after
     `repo init -u https://github.com/LineageOS/android.git -b lineage-23.2`.

     noam/lineage-23.2 branches carry changes on top of their source:
       device tree         chara's release + unmerged charger/module-loader
                           fixes + WPA3 nl80211 version opt-in
       wpa_supplicant_8    current LineageOS + CONFIG_DISABLE_WPA_VERSION_3
       frameworks/native   chara's libgui ABI fix, rebased on current LineageOS
       Settings, Telephony chara's native eSIM selection, rebased on current
                           LineageOS
     lineage-23.2 branches are chara's release state, unmodified.

     Kernel sources are built separately; see kernel_manifest-6.1.
-->
<manifest>
  <remote name="noamtu123" fetch="https://github.com/noamtu123/" />

  <!-- Device -->
  <remove-project path="device/xiaomi/malachite" optional="true" />
  <project path="device/xiaomi/malachite" name="android_device_xiaomi_malachite" remote="noamtu123" revision="noam/lineage-23.2" />
  <remove-project path="device/xiaomi/malachite-kernel" optional="true" />
  <project path="device/xiaomi/malachite-kernel" name="android_device_xiaomi_malachite-kernel" remote="noamtu123" revision="lineage-23.2" />
  <remove-project path="vendor/xiaomi/malachite" optional="true" />
  <project path="vendor/xiaomi/malachite" name="proprietary_vendor_xiaomi_malachite" remote="noamtu123" revision="lineage-23.2" />

  <!-- Platform -->
  <remove-project path="hardware/mediatek" optional="true" />
  <project path="hardware/mediatek" name="android_hardware_mediatek" remote="noamtu123" revision="lineage-23.2" />
  <remove-project path="hardware/xiaomi" optional="true" />
  <project path="hardware/xiaomi" name="android_hardware_xiaomi" remote="noamtu123" revision="lineage-23.2" />
  <remove-project path="device/mediatek/sepolicy_vndr" optional="true" />
  <project path="device/mediatek/sepolicy_vndr" name="android_device_mediatek_sepolicy_vndr" remote="noamtu123" revision="lineage-23.2" />
  <remove-project path="vendor/mediatek/ims" optional="true" />
  <project path="vendor/mediatek/ims" name="android_vendor_mediatek_ims" remote="noamtu123" revision="lineage-23.2" />

  <!-- Overrides of LineageOS projects -->
  <remove-project path="external/wpa_supplicant_8" optional="true" />
  <project path="external/wpa_supplicant_8" name="android_external_wpa_supplicant_8" remote="noamtu123" revision="noam/lineage-23.2" />
  <remove-project path="frameworks/native" optional="true" />
  <project path="frameworks/native" name="android_frameworks_native" remote="noamtu123" revision="noam/lineage-23.2" />
  <remove-project path="packages/apps/Settings" optional="true" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="noamtu123" revision="noam/lineage-23.2" />
  <remove-project path="packages/services/Telephony" optional="true" />
  <project path="packages/services/Telephony" name="android_packages_services_Telephony" remote="noamtu123" revision="noam/lineage-23.2" />
</manifest>
