<resources>
    <!-- Show battery cycle count -->
    <bool name="config_show_battery_cycle_count" translatable="false">true</bool>

    <!-- Settings > Battery saver > Limit CPU speed (init.mt6878.power.rc) -->
    <bool name="config_battery_saver_cpu_cap" translatable="false">true</bool>

    <!-- Settings > Display > Minimum and Maximum refresh rate. The same rate for both keeps
         the panel from switching modes at all. The lists can't cross. -->
    <bool name="config_show_min_refresh_rate_switch" translatable="false">true</bool>
    <bool name="config_show_peak_refresh_rate_switch" translatable="false">true</bool>

    <!-- mifaced opens the front camera itself and draws the enrollment preview into
         the surface Settings passes to FaceManager.enroll() (LineageOS 24.0 flag). -->
    <bool name="config_face_enroll_hal_owns_camera">true</bool>
</resources>
