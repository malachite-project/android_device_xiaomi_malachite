<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<displayConfiguration>
    <densityMapping>
        <density>
            <height>2712</height>
            <width>1220</width>
            <density>490</density>
        </density>
    </densityMapping>
    <!-- Global Brightness-Nit mapping -->
    <screenBrightnessMap>
        <point>
            <value>0.000683661</value>
            <nits>2.0</nits>
        </point>
        <point>
            <value>0.499951</value>
            <nits>500.0</nits>
        </point>
        <point>
            <value>0.999755836</value>
            <nits>1200.0</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>1201.0</nits>
        </point>
    </screenBrightnessMap>
    <ambientLightHorizonLong>3000</ambientLightHorizonLong>
    <ambientLightHorizonShort>1000</ambientLightHorizonShort>
    <!-- Brightness ramps, in HLG (perceptual) brightness per second; the whole normal
         range (2-500 nits) is about 0.83. Without these the framework uses config.xml's
         0.705 and 0.232 for everything, so an auto-brightness change was over in about half
         a second (a quarter with a 0.5x animator duration scale) and looked like a jump.
         Slow: auto-brightness following the light. Brightening at 0.05 is capped at 3 s so
         stepping outside stays quick (HyperOS: about 4 s); darkening at 0.03 is capped at
         10 s (HyperOS: 10-30 s). Fast: the first value after the screen turns on and
         slider changes, unchanged. All four rates must be present or all are ignored. -->
    <screenBrightnessRampFastDecrease>0.7047244</screenBrightnessRampFastDecrease>
    <screenBrightnessRampFastIncrease>0.7047244</screenBrightnessRampFastIncrease>
    <screenBrightnessRampSlowDecrease>0.03</screenBrightnessRampSlowDecrease>
    <screenBrightnessRampSlowIncrease>0.05</screenBrightnessRampSlowIncrease>
    <screenBrightnessRampIncreaseMaxMillis>3000</screenBrightnessRampIncreaseMaxMillis>
    <screenBrightnessRampDecreaseMaxMillis>10000</screenBrightnessRampDecreaseMaxMillis>
    <!-- How much the ambient light must change before auto-brightness recalculates, in
         percent of the current lux from each lux level up, and at least `minimum` lux.
         HyperOS waits for much larger changes (at 30 lux: above 160 or below 16). The
         screen then changes only if the new brightness differs by 10 % up or 20 % down. -->
    <ambientBrightnessChangeThresholds>
        <brighteningThresholds>
            <minimum>2</minimum>
            <brightnessThresholdPoints>
                <brightnessThresholdPoint>
                    <threshold>0</threshold><percentage>100</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>2</threshold><percentage>60</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>10</threshold><percentage>50</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>30</threshold><percentage>40</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>100</threshold><percentage>30</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>800</threshold><percentage>25</percentage>
                </brightnessThresholdPoint>
            </brightnessThresholdPoints>
        </brighteningThresholds>
        <darkeningThresholds>
            <minimum>1</minimum>
            <brightnessThresholdPoints>
                <brightnessThresholdPoint>
                    <threshold>0</threshold><percentage>60</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>10</threshold><percentage>50</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>30</threshold><percentage>40</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>100</threshold><percentage>35</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>800</threshold><percentage>30</percentage>
                </brightnessThresholdPoint>
            </brightnessThresholdPoints>
        </darkeningThresholds>
    </ambientBrightnessChangeThresholds>
    <highBrightnessMode enabled="true">
        <!-- Transition point brightness from normal to HBM mode -->
        <transitionPoint>0.499951</transitionPoint>
        <!-- Minimum lux to enter HBM -->
        <minimumLux>6001</minimumLux>
        <!-- Time limitation for HBM. All zeros leave no remaining time, and
             HighBrightnessModeController then re-arms its recalculation for
             "now" on every pass while brightness is above the transition point.
             Allow sunlight brightness for up to the whole 30 min window; once
             it is used up, wait for 60 s of budget before boosting again. -->
        <timing>
            <timeWindowSecs>1800</timeWindowSecs>
            <timeMaxSecs>1800</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <!-- Thermal limitation for HBM -->
        <thermalStatusLimit>critical</thermalStatusLimit>
        <!-- Low power mode limitation for HBM -->
        <allowInLowPowerMode>true</allowInLowPowerMode>
        <!-- HDR headroom: stock's 8x ratio (/product/etc/displayconfig). Without a ratio map the
             framework has no HDR brightness and HDR video is tone-mapped down to SDR white.
             The backlight goes through the lights HAL here, not the composer, so the boost
             raises the whole screen rather than only the HDR layer; stock's 0 % would do that
             for every HDR thumbnail. Keep the framework default: HDR must cover half the
             screen. -->
        <minimumHdrPercentOfScreen>0.5</minimumHdrPercentOfScreen>
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>8.0</hdrRatio>
            </point>
            <point>
                <sdrNits>1200.0</sdrNits>
                <hdrRatio>8.0</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>
</displayConfiguration>
